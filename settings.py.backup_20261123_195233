import os
from dataclasses import dataclass
from pathlib import Path

from dotenv import load_dotenv


BASE_DIR = Path(__file__).resolve().parent
load_dotenv(BASE_DIR / ".env")


def env_bool(name: str, default: bool = False) -> bool:
    value = os.getenv(name)
    if value is None:
        return default
    return value.strip().lower() in {"1", "true", "yes", "on"}


@dataclass(frozen=True)
class Settings:
    api_base_url: str
    agent_api_key: str
    agent_id: str
    rocketbot_url: str
    robot_name: str
    editor_url: str
    poll_seconds: int
    heartbeat_seconds: int
    execution_timeout_seconds: int
    dry_run: bool
    allowed_real_click: bool
    headless: bool
    state_file: Path
    rocketbot_executable: str
    robot_database: str
    rocketbot_log_dir: str

    @classmethod
    def from_environment(cls) -> "Settings":
        return cls(
            api_base_url=os.getenv("API_BASE_URL", "").rstrip("/"),
            agent_api_key=os.getenv("AGENT_API_KEY", ""),
            agent_id=os.getenv("AGENT_ID", "rocketbot-clima-agent"),
            rocketbot_url=os.getenv("ROCKETBOT_URL", "http://localhost:5000/"),
            robot_name=os.getenv("ROBOT_NAME", "Clima"),
            editor_url=os.getenv(
                "ROCKETBOT_EDITOR_URL",
                "http://localhost:5000/editor/#/edit/Clima/db/"
                "QzpcVXNlcnNcVVNFUlxEb2N1bWVudHNcUm9ja2V0Ym90XHJvYm90LmRi",
            ),
            poll_seconds=int(os.getenv("POLL_SECONDS", "5")),
            heartbeat_seconds=int(os.getenv("HEARTBEAT_SECONDS", "5")),
            execution_timeout_seconds=int(
                os.getenv("EXECUTION_TIMEOUT_SECONDS", "600")
            ),
            dry_run=env_bool("DRY_RUN", True),
            allowed_real_click=env_bool("ALLOW_REAL_EXECUTION", False),
            headless=env_bool("SELENIUM_HEADLESS", False),
            state_file=BASE_DIR / ".agent_state.json",
            rocketbot_executable=os.getenv(
                "ROCKETBOT_EXECUTABLE",
                r"C:\Users\USER\Documents\Rocketbot\rocketbot.exe",
            ),
            robot_database=os.getenv(
                "ROBOT_DATABASE",
                r"C:\Users\USER\Documents\Rocketbot\robot.db",
            ),
            rocketbot_log_dir=os.getenv(
                "ROCKETBOT_LOG_DIR",
                str(BASE_DIR / "rocketbot_logs"),
            ) or str(BASE_DIR / "rocketbot_logs"),
        )
